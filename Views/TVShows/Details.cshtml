@model SistaProjektSeptember2026.Models.TVShow

@{ ViewData["Title"] = "Details"; }

<h1>Mer om <i>@Html.DisplayFor(model => model.Title)</i></h1>

<div>
	<h4>TV-serie</h4>
	<hr />
	<dl class="row">
		<dt class = "col-sm-2">
			@Html.DisplayNameFor(model => model.Seasons)
		</dt>
		<dd class = "col-sm-10">
			@Html.DisplayFor(model => model.Seasons)
		</dd>
		<dt class = "col-sm-2">
			@Html.DisplayNameFor(model => model.EpisodesPerSeason)
		</dt>
		<dd class = "col-sm-10">
			@Html.DisplayFor(model => model.EpisodesPerSeason)
		</dd>
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.Director)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.Director)
		</dd>

		<dt class = "col-sm-2">
			@Html.DisplayNameFor(model => model.Genres)
		</dt>
		<dd class = "col-sm-10">
		@if (Model.Genres > 0)
			@Html.DisplayFor(model => model.Genres)
		else
		{
			<p>Inga genrer angivna</p>				
		}
		</dd>

		<dt class = "col-sm-2">
			@Html.DisplayNameFor(model => model.Year)
		</dt>
		<dd class = "col-sm-10">
			@Html.DisplayFor(model => model.Year)
		</dd>

		<dt class = "col-sm-2">
			@Html.DisplayNameFor(model => model.Actors)
		</dt>
		<dd class = "col-sm-10">
			@Html.DisplayFor(model => model.Actors)
		</dd>

		<dt class = "col-sm-2">
			@Html.DisplayNameFor(model => model.AgeGroup)
		</dt>
		<dd class = "col-sm-10">
			@Html.DisplayFor(model => model.AgeGroup)
		</dd>

		<dt class = "col-sm-2">
			@Html.DisplayNameFor(model => model.Reviews)
		</dt>
		<dd class = "col-sm-10">
			@Html.DisplayFor(model => model.Reviews)
		</dd>
	</dl>
</div>
<div>
	@if (User.Identity.IsAuthenticated)
	{
		<a asp-action="Edit" asp-route-id="@Model?.Id">Redigera info</a>
	}
	<a asp-action="Index">Tillbaka till listan</a>
</div>