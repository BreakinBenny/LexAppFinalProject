@model SistaProjektSeptember2026.Models.TVShow

@{ ViewData["Title"] = "Delete"; }

<h1>Radera</h1>

<h3>Vill du ta bort <i>@Html.DisplayFor(model => model.Title)</i> (ID: @Html.DisplayFor(model => model.Id))?</h3>
<div>
	<hr />
	<dl class="row">
		<dt class = "col-sm-2">
			@Html.DisplayNameFor(model => model.Seasons)
		</dt>
		<dd class = "col-sm-10">
			@Html.DisplayFor(model => model.Seasons)
		</dd>
	</dl>

	<dl class="row">
		<dt class = "col-sm-2">
			@Html.DisplayNameFor(model => model.EpisodesPerSeason)
		</dt>
		<dd class = "col-sm-10">
			@Html.DisplayFor(model => model.EpisodesPerSeason)
		</dd>
	</dl>

	<dl class="row">
		<dt class = "col-sm-2">
			@Html.DisplayNameFor(model => model.Genres)
		</dt>
		<dd class = "col-sm-10">
			@Html.DisplayFor(model => model.Genres)
		</dd>
	</dl>

	<dl class="row">
		<dt class = "col-sm-2">
			@Html.DisplayNameFor(model => model.Year)
		</dt>
		<dd class = "col-sm-10">
			@Html.DisplayFor(model => model.Year)
		</dd>
	</dl>

	<dl class="row">
		<dt class = "col-sm-2">
			@Html.DisplayNameFor(model => model.Actors)
		</dt>
		<dd class = "col-sm-10">
			@Html.DisplayFor(model => model.Actors)
		</dd>
	</dl>

	<dl class="row">
		<dt class = "col-sm-2">
			@Html.DisplayNameFor(model => model.AgeGroup)
		</dt>
		<dd class = "col-sm-10">
			@Html.DisplayFor(model => model.AgeGroup)
		</dd>
	</dl>

	<dl class="row">
		<dt class = "col-sm-2">
			@Html.DisplayNameFor(model => model.Reviews)
		</dt>
		<dd class = "col-sm-10">
			@Html.DisplayFor(model => model.Reviews)
		</dd>
	</dl>

	<form asp-action="Delete">
		<input type="hidden" asp-for="Id" />
		<input type="submit" value="Radera" class="btn btn-danger" /> |
		<a asp-action="Index">Tillbaka till listan</a>
	</form>
</div>