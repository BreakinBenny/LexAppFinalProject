@model CreateTVShowModel
@{
	var OMDbFetch = new OMDbResponseTVShow();
}

<h2>Lägg till TV-serie</h2>

<hr />
<form method="get">
	<div class="form-actions no-color">
		<p>
			<label>API-nyckel: <input type="text" name="apikey" /></label>
			<label>
				<input type="text" placeholder="Sök TV-serietitel... (ex. Everwood, Alfons Åberg...)" name="t" />
			</label>
			<input type="submit" value="Sök (med API)" class="btn btn-primary" />
		</p>
	</div>
</form>

<div class="row">
	<div class="col-md-4">
		<form method="post" asp-action="Create">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>

			<div class="form-group">
				<label asp-for="@Model.OMDbFetch.totalSeasons" class="control-label"></label>
				<input asp-for="@Model.OMDbFetch.totalSeasons" class="form-control" />
				<span asp-validation-for="@Model.OMDbFetch.totalSeasons" class="text-danger"></span>
			</div>
@*
			<div class="form-group">
				<label asp-for="@Model.OMDbFetch.EpisodesPerSeason" class="control-label"></label>
				<input asp-for="@Model.OMDbFetch.EpisodesPerSeason" class="form-control" />
				<span asp-validation-for="@Model.OMDbFetch.EpisodesPerSeason" class="text-danger"></span>
			</div>
*@
			<div class="form-group">
				<label asp-for="@Model.OMDbFetch.Title" class="control-label"></label>
				<input asp-for="@Model.OMDbFetch.Title" class="form-control" />
				<span asp-validation-for="@Model.OMDbFetch.Title" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="@Model.OMDbFetch.Director" class="control-label"></label>
				<input asp-for="@Model.OMDbFetch.Director" class="form-control" />
				<span asp-validation-for="@Model.OMDbFetch.Director" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="@Model.OMDbFetch.Genre" class="control-label"></label>
				<input asp-for="@Model.OMDbFetch.Genre" id="Genres" value="0" type="hidden" />

				<div>
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="1" /> Action
					</label>
				
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="2" /> Adventure
					</label>
				
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="4" /> Animated
					</label>

					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="8" /> Anime
					</label>

					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="16" /> Christmas
					</label>
				
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="32" /> Comedy
					</label>
				
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="64" /> Criminal
					</label>
				
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="128" /> Drama
					</label>
				
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="256" /> Family
					</label>

					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="512" /> History
					</label>
				
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="1024" /> Horror
					</label>
				
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="2048" /> Mystery
					</label>
				
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="4096" /> Romance
					</label>
				
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="8192" /> SciFi
					</label>
				
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="16384" /> Thriller
					</label>
				</div>

				<span asp-validation-for="@Model.OMDbFetch.Genre" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="@Model.OMDbFetch.Year" class="control-label"></label>
				<input asp-for="@Model.OMDbFetch.Year" class="form-control" />
				<span asp-validation-for="@Model.OMDbFetch.Year" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="@Model.OMDbFetch.Actors" class="control-label"></label>
				<input asp-for="@Model.OMDbFetch.Actors" class="form-control" />
				<span asp-validation-for="@Model.OMDbFetch.Actors" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="@Model.OMDbFetch.Rated" class="control-label"></label>
				<input asp-for="@Model.OMDbFetch.Rated" id="AgeGroup" value="0" type="hidden" />

                @Html.RadioButtonFor(m => OMDbFetch.Rated, 0) Åkdersgräns saknas
				@Html.RadioButtonFor(m => OMDbFetch.Rated, 1) Kan ses av alla åldrar
				@Html.RadioButtonFor(m => OMDbFetch.Rated, 2) Från 7 år
				@Html.RadioButtonFor(m => OMDbFetch.Rated, 4) Från 11 år
				@Html.RadioButtonFor(m => OMDbFetch.Rated, 8) Från 15 år

				<span asp-validation-for="OMDbFetch.Rated" class="text-danger"></span>
			</div>
@*
			<div class="form-group">
				<label asp-for="@Model.OMDbFetch.Reviews" class="control-label"></label>
				<input asp-for="@Model.OMDbFetch.Reviews" class="form-control" />
				<span asp-validation-for="@Model.OMDbFetch.Reviews" class="text-danger"></span>
			</div>
*@
			<div class="form-group">
				<input type="submit" value="Lägg till" class="btn btn-primary" />
			</div>
		</form>
	</div>
</div>

<div>
	<a asp-action="Index">Tillbaka till listan</a>
</div>

@section Scripts {
<script>
	( function() {
		const hidden = document.getElementById('Genres');
		const boxes = document.querySelectorAll('.genre-checkbox');

		function updateMask() {
			let mask = 0;
			boxes.forEach(b => {
				if (b.checked) mask |= Number(b.getAttribute('data-value') || 0);
			});

			hidden.value = mask;
		}

		boxes.forEach(b => b.addEventListener('change', updateMask));
		updateMask();	// When loading, initialize
	}) ();
</script>
}