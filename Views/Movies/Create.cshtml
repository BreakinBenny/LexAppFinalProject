@inject IHttpClientFactory HttpClientFactory
@inject OMDbResponseMovie OMDbFetch
@model SistaProjektSeptember2026.Models.Movie

@{
	ViewData["Title"] = "Create";
	var OMDbFetch = new OMDbResponseMovie();
	
}

<h2>Lägg till film</h2>

<hr />
<form method="get">
	<div class="form-actions no-color">
		<p>
			<label for="apiKey">API-nyckel:</label>
				<input type="text" name="apikey" />
			<label>
				<input type="text" placeholder="Sök filmtitel..." name="t" />
			</label>
			<input type="submit" value="Sök (med API)" class="btn btn-primary" />
		</p>
	</div>
</form>

<div class="text-center" align="right">
	@if (OMDbFetch != null && !string.IsNullOrEmpty(OMDbFetch.Poster))
	{
		<img src="@OMDbFetch.Poster" alt="Affisch för @OMDbFetch.Title" />
	} else { <p>NO MOVIE POSTER (yet)!</p> }

	@if (OMDbFetch != null && !string.IsNullOrEmpty(OMDbFetch.Plot))
	{
		<h2>Plot:</h2>
		<p><i>@OMDbFetch.Plot</i></p>
	}
	else
	{
		<p><i>'Twas a dark and stormy night...</i></p>
	}
	
</div>

<div class="row">
	<div class="col-md-4">
		<form asp-action="Create">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>

			<div class="form-group">
				<label asp-for="Runtime" class="control-label"></label>
				<input asp-for="Runtime" class="form-control" />
				<span asp-validation-for="Runtime" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="Title" class="control-label"></label>
				<input asp-for="Title" class="form-control" />
				<span asp-validation-for="Title" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="Director" class="control-label"></label>
				<input asp-for="Director" class="form-control" />
				<span asp-validation-for="Director" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="Year" class="control-label"></label>
				<input asp-for="Year" class="form-control" />
				<span asp-validation-for="Year" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="Genres" class="control-label"></label>
				<input asp-for="Genres" id="Genres" value="0" type="hidden" />

				<div>
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="1" /> Action
					</label>
				
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="2" /> Adventure
					</label>
				
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="4" /> Animated
					</label>

					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="8" /> Anime
					</label>

					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="16" /> Christmas
					</label>
				
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="32" /> Comedy
					</label>
				
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="64" /> Criminal
					</label>
				
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="128" /> Drama
					</label>
				
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="256" /> Family
					</label>

					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="512" /> History
					</label>
				
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="1024" /> Horror
					</label>
				
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="2048" /> Mystery
					</label>
				
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="4096" /> Romance
					</label>
				
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="8192" /> SciFi
					</label>
				
					<label class="form-check-label">
					<input class="form-check-input genre-checkbox" type="checkbox" data-value="16384" /> Thriller
					</label>
				</div>

				<span asp-validation-for="Genres" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="Actors" class="control-label"></label>
				<input asp-for="Actors" class="form-control" />
				<span asp-validation-for="Actors" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="AgeGroup" class="control-label"></label>
				<input asp-for="AgeGroup" id="AgeGroup" value="0" type="hidden" />

				@Html.RadioButtonFor(m => m.AgeGroup, 0) Okänd åldersgräns
				@Html.RadioButtonFor(m => m.AgeGroup, 1) Kan ses av alla åldrar
				@Html.RadioButtonFor(m => m.AgeGroup, 2) Från 7 år
				@Html.RadioButtonFor(m => m.AgeGroup, 3) Från 11 år
				@Html.RadioButtonFor(m => m.AgeGroup, 4) Från 15 år

				<span asp-validation-for="AgeGroup" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="Reviews" class="control-label"></label>
				<input asp-for="Reviews" class="form-control" />
				<span asp-validation-for="Reviews" class="text-danger"></span>
			</div>

			<div class="form-group">
				<input type="submit" value="Create" class="btn btn-primary" />
			</div>
		</form>
	</div>
</div>

<div>
	<a asp-action="Index">Back to List</a>
</div>

@section Scripts {
<script>
	( function() {
		const hidden = document.getElementById('Genres');
		const boxes = document.querySelectorAll('.genre-checkbox');

		function updateMask() {
			let mask = 0;
			boxes.forEach(b => {
				if (b.checked) mask |= Number(b.getAttribute('data-value') || 0);
			});

			hidden.value = mask;
		}

		boxes.forEach(b => b.addEventListener('change', updateMask));
		updateMask();	// When loading, initialize
	}) ();
</script>
}