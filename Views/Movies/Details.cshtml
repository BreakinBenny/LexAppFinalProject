		<dd class = "col-sm-10">
@*			@if (Model.Reviews.Length > 1)
				@Html.DisplayFor(model => model.Reviews)
			else
*@				@Html.DisplayFor(model => model.Reviews[0])
		</dd>
	</dl>
</div>
<div>
	@if (User.Identity.IsAuthenticated)
	{
		<a asp-action="Edit" asp-route-id="@Model?.Id">Redigera info</a>
	}
	<a asp-action="Index">Tillbaka till listan</a>
