@model IEnumerable<FinalProjectforSeptember.Models.Movie>

@{
	ViewData["Title"] = "Index";
}

<h1>Index</h1>
@if (User.Identity.IsAuthenticated)
{
	<p>
		<a asp-action="Create">Lägg till film</a>
	</p>
}

<table class="table">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(model => model.Title)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Runtime)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Date)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Actors)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.AgeGroup)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Reviews)
			</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
@foreach (var item in Model) {
		<tr>
			<td>
				@Html.DisplayFor(model => item.Title)
			</td>
			<td>
				@Html.DisplayFor(model => item.Runtime)
			</td>
			<td>
				@Html.DisplayFor(model => item.Date)
			</td>
			<td>
				@Html.DisplayFor(model => item.Actors)
			</td>
			<td>
				@Html.DisplayFor(model => item.AgeGroup)
			</td>
			<td>
				@Html.DisplayFor(model => item.Reviews)
			</td>
			<td>
				<a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
				<a asp-action="Details" asp-route-id="@item.Id">Details</a> |
				<a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
			</td>
		</tr>
}
	</tbody>
</table>